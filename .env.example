NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=sms_nepal
DB_SCHEMA=public
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Nepal
TIMEZONE=Asia/Kathmandu
DEFAULT_LANGUAGE=ne

# Frontend URL (for callbacks)
FRONTEND_URL=http://localhost:3000

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_
ENCRYPTION_IV=your_16_character_i

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============ Payment Gateways ============

# eKhalti (Nepal's payment gateway)
EKHALTI_PUBLIC_KEY=
EKHALTI_SECRET_KEY=
EKHALTI_API_URL=https://khalti.com/api/v2/

# ConnectIPS (Nepal Bank's payment gateway)
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_SECRET_KEY=
CONNECTIPS_API_URL=https://payment.connectips.com/

# Stripe (International payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (International payments)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ============ Video Conferencing ============

# Jitsi Meet
JITSI_DOMAIN=meet.jit.si

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=

# Google Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ File Upload ============

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ============ SMS/Email Notifications ============

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@school.edu.np

# ============ AI Services ============

OPENAI_API_KEY=

# ============ Logging ============

LOG_LEVEL=debug
