# ============================================
# Production Environment Configuration
# ============================================
# Copy this file to .env and update values

# ============================================
# Server
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# Database
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=sms_nepal
DB_SCHEMA=public
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=3600
REDIS_PASSWORD=

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Nepal Config
# ============================================
TIMEZONE=Asia/Kathmandu
DEFAULT_LANGUAGE=ne

# ============================================
# CORS & Security
# ============================================
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000,http://localhost:3001

# ============================================
# Encryption
# ============================================
ENCRYPTION_KEY=your_32_character_encryption_key_
ENCRYPTION_IV=your_16_character_iv

# ============================================
# Frontend URL (for callbacks)
# ============================================
FRONTEND_URL=https://your-domain.com

# ============================================
# SMS API (Optional)
# ============================================
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://sms.example.com/api

# ============================================
# Email (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# ============================================
# Twilio SMS (Optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# WhatsApp Business (Optional)
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=

# ============================================
# Payment Gateways (Optional)
# ============================================
EKHALTI_PUBLIC_KEY=
EKHALTI_SECRET_KEY=
EKHALTI_API_URL=https://khalti.com/api/v2/

CONNECTIPS_MERCHANT_ID=
CONNECTIPS_SECRET_KEY=
CONNECTIPS_API_URL=https://payment.connectips.com/

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ============================================
# Video Conferencing (Optional)
# ============================================
JITSI_DOMAIN=meet.jit.si
ZOOM_API_KEY=
ZOOM_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# File Upload
# ============================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# AI Services (Optional)
# ============================================
OPENAI_API_KEY=

# ============================================
# Feature Flags
# ============================================
SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true

# ============================================
# Application URL (for emails, etc.)
# ============================================
APP_URL=https://api.your-domain.com
