{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "i18n/**/*", "outDir": "dist/src" },
      "database/seeds/final.json"
    ],
    "watchAssets": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json"
  },
  "generateOptions": {
    "strict": true
  },
  "monorepo": false,
  "root": "",
  "items": []
}
